namespace om636 {
namespace control {

    /////////////////////////////////////////////////////////////////////////////////////
    // shared_agent
    /////////////////////////////////////////////////////////////////////////////////////
    template <typename... T>
    template <typename V>
    shared_agent<T...>::shared_agent(V&& callback)
        : m_callback(callback)
    {
    }

    /////////////////////////////////////////////////////////////////////////////////////
    template <typename... T>
    void shared_agent<T...>::invoke(T... args)
    {
        m_callback(args...);
    }

} //control
